# which llm provider to use: anthropic (default), openai, or groq
LLM_PROVIDER=anthropic

# anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# openai (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# groq (only needed if LLM_PROVIDER=groq) - openai-compatible api, different base url
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
